pipeline {
    agent any

    environment {
        JAVA_HOME = "/usr/lib/jvm/java-17-openjdk-amd64"
        PATH = "${JAVA_HOME}/bin:${env.PATH}"
    }

    stages {

        stage('PULL STAGE') {
            steps {
                git 'https://github.com/Vishwajeet-Pawar-Commits/jenkins.git'
                echo "PULL SUCCESS"
            }
        }

        stage('BUILD STAGE') {
            steps {
                dir('backend') {
                    sh 'java -version'
                    sh 'mvn clean package -DskipTests'
                }
                echo "BUILD SUCCESS"
            }
        }

        stage('TEST STAGE') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    dir('backend') {
                        sh '''
                            mvn sonar:sonar \
                            -Dsonar.projectKey=test-project \
                            -Dsonar.projectName=test-project \
                 
                        '''
                    }
		     echo "GREAT TEST SUCCESS"

                }
               
            }
        }


          stage('QualityGate STAGE') {
            steps {
	        timeout(time: 1, unit: 'MINUTES' ) {
		waitForQualityGate abortPipeline: false, credentialsId: 'SonarQube'
                echo "QUALITY OK"
               }
           }
	}






        stage('DEPLOY STAGE') {
            steps {
                echo "THE GREAT DEPLOY SUCCESS"
            }
        }
    }
}
